# =====================================================================
# Variables de entorno para PRODUCCION (VPS + Coolify)
# Copia estas variables en Coolify > tu aplicacion > Environment Variables.
# NO subas este archivo con valores reales al repositorio.
# =====================================================================

APP_NAME=Hancco Artesanias
APP_ENV=production
# Genera una con: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
# Dominio publico del backend (con https). Sin dominio propio: subdominio gratis de DuckDNS
APP_URL=https://hancco-api.duckdns.org
# Dominio publico del frontend en Vercel (para enlaces de correos)
FRONTEND_URL=https://hancco-artesanias.vercel.app
# Origenes extra permitidos por CORS, separados por coma (ademas de FRONTEND_URL)
CORS_ALLOWED_ORIGINS=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Base de datos MySQL creada en Coolify (mismo proyecto).
# DB_HOST es el nombre interno que Coolify muestra para el servicio MySQL.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=hancco_artesanias
DB_USERNAME=hancco
DB_PASSWORD=

# Minutos que dura el token de login antes de vencer (480 = 8 horas)
SANCTUM_TOKEN_EXPIRATION=480

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Correo (recuperar contrasena). Ejemplo con Resend o Brevo por SMTP.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hancco Artesanias

# Cloudflare R2 (las mismas credenciales que ya usas)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=hancco-imagenes
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_REGION=auto

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
GEMINI_TIMEOUT=120

YAPE_NUMERO=
YAPE_QR_URL=
WHATSAPP_TIENDA=

# Culqi (cambiar a claves live y CULQI_ENV=production cuando se venda de verdad)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_ENV=sandbox
